# R2 存储管理器 - 环境变量配置示例
# 请复制此文件为 .env 并填入您的实际凭证

# Cloudflare R2 Access Key ID
# 从 Cloudflare Dashboard 获取: https://dash.cloudflare.com/
R2_ACCESS_KEY_ID=your_access_key_id_here

# Cloudflare R2 Secret Access Key
# 从 Cloudflare Dashboard 获取: https://dash.cloudflare.com/
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# 注意事项:
# 1. 请勿将包含真实凭证的 .env 文件提交到版本控制系统
# 2. 确保 .env 文件已添加到 .gitignore
# 3. 凭证信息可以从 Cloudflare R2 控制台的 API Tokens 页面获取
# 4. 这些凭证用于访问 R2 存储桶 "picture"
